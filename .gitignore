# Prodotti di compilazione dei due progetti qui dentro.
bin/
obj/

# Log delle esecuzioni: server, web API, banco di carico, prove sulle regole.
# Cambiano a ogni giro e non dicono niente a chi legge la storia del repository.
logs/

# Messaggi di commit in lavorazione. ship.ps1 li scrive, li usa e li cancella:
# esistono solo fra il momento in cui si prepara un commit e quello in cui parte.
msg/

# Lucchetti: agente.lock (un agente al lavoro), regole.lock e bench.lock (prove
# in corso, letti da run.ps1). Valgono solo su questo PC e solo finche' dura il
# giro che li ha scritti.
*.lock

# Configurazione di produzione con le password vere: si prepara da
# produzione/.env.esempio e resta solo sulla macchina dove gira.
produzione/.env
