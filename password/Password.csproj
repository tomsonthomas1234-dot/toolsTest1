<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Password</AssemblyName>
    <RootNamespace>Password</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Si riusa la stessa Passwords del gioco invece di riscrivere PBKDF2:
         se un giorno cambieranno iterazioni o algoritmo, questo strumento
         cambia con loro. Una copia separata continuerebbe a scrivere hash che
         il gioco non sa piu leggere. -->
    <ProjectReference Include="..\..\bootstrap\01_shared\src\Precursori.Shared\Precursori.Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.1" />
  </ItemGroup>
</Project>
