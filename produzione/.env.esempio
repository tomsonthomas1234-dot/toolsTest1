# Configurazione di produzione. Copiare in .env (che non va mai committato) e
# riempire ogni valore. docker compose si rifiuta di partire se ne manca uno.
#
# Password e segreti: solo lettere e cifre, lunghi. Un punto e virgola romperebbe
# la stringa di connessione a Postgres. Per generarne uno su Linux:
#
#   openssl rand -hex 32

# Database. Si sceglie al primo avvio: dopo, cambiarlo qui non cambia la
# password dentro il volume gia creato.
POSTGRES_PASSWORD=

# Archivio dei mondi (MinIO). Utente di almeno 3 caratteri, password di almeno 8.
MINIO_USER=
MINIO_PASSWORD=

# Segreto con cui la web API firma i token e il game server li verifica.
# Cambiarlo fa scadere tutti gli accessi: i giocatori rientrano con la password.
AUTH_SECRET=

# Nome dell'account amministratore (quello con cui si gioca).
ADMIN=

# Porte pubbliche. Facoltative: senza, 27015 (UDP) e 5080 (TCP).
# GAME_PORT=27015
# WEBAPI_PORT=5080
